---
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import EstudioLineaBaseContent from "@/components/estudio-linea-base/EstudioLineaBaseContent";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Estudio de línea base | Cuidda"
  description="Antecedentes e información base del sistema de vigilancia"
>
  <VigilanciaPagePlaceholder
    title="Estudio de línea base"
    icon="fa-file-lines"
    description="Antecedentes, estructura, información sensible y objetivos de la empresa. Esta base alimenta el motor de validación que cruza factores de riesgo, IPERC, monitoreos y hallazgos médicos."
    buttons={[
      {
        state: true,
        icon: "fa-upload",
        text: "CARGAR DOCUMENTO",
      },
    ]}
  />
  <div class="flex-1 overflow-y-auto py-6">
    <EstudioLineaBaseContent client:load />
  </div>
</DashboardLayout>
