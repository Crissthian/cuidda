---
import EmosTrabajadoresContent from "@/components/emos-y-trabajadores/EmosTrabajadoresContent";
import EmosModalHost from "@/components/emos-y-trabajadores/EmosModalHost";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Matriz de salud de los trabajadores"
  description="Módulo de EMOs y trabajadores"
>
  <VigilanciaPagePlaceholder
    title="Matriz de salud de los trabajadores"
    icon="fa-users"
    description="Carga la data de salud como matriz o legajos en PDF. La plataforma filtra según los factores de riesgo definidos por el cliente y clasifica cada trabajador en su grupo de riesgo."
    buttons={[
      {
        icon: "fa-upload",
        text: "CARGAR MATRIZ Y LEGAJOS",
      },
    ]}
  />
  <div>
    <EmosTrabajadoresContent client:load />
  </div>
  <EmosModalHost client:load />
</DashboardLayout>
