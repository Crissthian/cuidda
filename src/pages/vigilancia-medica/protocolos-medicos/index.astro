---
import ProtocolosContent from "@/components/protocolos/ProtocolosContent";
import ProtocolosModalHost from "@/components/protocolos/ProtocolosModalHost";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Protocolos médicos"
  description="Módulo de protocolos médicos"
>
  <div class="flex flex-1 flex-col overflow-y-auto bg-surface-default">
    <VigilanciaPagePlaceholder
      title="Protocolos médicos"
      icon="fa-book-medical"
      description="Módulo protocolos médicos del sistema de vigilancia médica ocupacional CUIDDA."
      buttons={[
        {
          icon: "fa-upload",
          text: "CARGAR PROTOCOLO",
        },
      ]}
    />
    <div>
      <ProtocolosContent client:load />
    </div>
    <ProtocolosModalHost client:load />
  </div>
</DashboardLayout>
