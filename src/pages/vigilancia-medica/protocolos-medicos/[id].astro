---
import ProtocoloDetalleContent from "@/components/protocolos/ProtocoloDetalleContent";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { protocolos } from "@/lib/protocolosData";

type Protocolo = (typeof protocolos)[number];

interface Props {
  protocolo: Protocolo;
}

export function getStaticPaths() {
  return protocolos.map((protocolo) => ({
    params: { id: String(protocolo.id) },
    props: { protocolo },
  }));
}

const { protocolo } = Astro.props;
const titulo = protocolo ? `Detalle de protocolo` : "Protocolo no encontrado";
---

<DashboardLayout title={titulo} description="Detalle del protocolo médico">
  <div class="flex flex-1 flex-col overflow-y-auto bg-surface-default">
    <div class="flex items-center gap-4 pt-4">
      <a
        href="/vigilancia-medica/protocolos-medicos"
        class="flex items-center gap-2 text-xs font-medium text-brand hover:text-primary-hover"
      >
        <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
        Volver a protocolos médicos
      </a>
    </div>
    <VigilanciaPagePlaceholder
      title="PROTOCOLO EMO ADMINISTRATIVOS"
      icon="fa-book-medical"
      description="DPRT-ADM-01 · Minera Andes Sur S.A."
      buttons={[
        {
          icon: "fa-save",
          text: "ACTUALIZAR PROTOCOLO",
          classes: ["bg-brand text-white hover:bg-brand-hover"],
        },
      ]}
    />
    <div class="max-h-175 overflow-y-auto">
      <ProtocoloDetalleContent protocolo={protocolo} client:load />
    </div>
  </div>
</DashboardLayout>
