---
import AusentismoMorbilidadContent from "@/components/vigilancia/AusentismoMorbilidadContent";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Ausentismos / Morbilidad"
  description="Módulo de ausentismos y morbilidad"
>
  <div class="flex flex-1 flex-col overflow-y-auto">
    <VigilanciaPagePlaceholder
      title="Ausentismos / Morbilidad"
      icon="fa-calendar-xmark"
      description="Módulo ausentismo / morbilidad del sistema de vigilancia médica ocupacional CUIDDA."
      buttons={[
        {
          icon: "fa-plus",
          text: "CARGAR DESCANSOS",
        },
      ]}
    />
    <div class="pb-6">
      <AusentismoMorbilidadContent client:load />
    </div>
  </div>
</DashboardLayout>
