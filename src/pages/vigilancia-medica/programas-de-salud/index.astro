---
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import ProgramasContent from "@/components/programas/ProgramasContent";
import ProgramasModalHost from "@/components/programas/ProgramasModalHost";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Programas de salud ocupacional"
  description="Módulo de programas de salud ocupacional segmentados por grupo de riesgo"
>
  <div class="flex flex-1 flex-col overflow-y-auto">
    <VigilanciaPagePlaceholder
      title="Programas de salud segmentados por grupo de riesgo"
      icon="fa-user-shield"
      description="Programas ocupacionales, preventivos y subprogramas con seguimiento del cumplimiento de actividades."
      buttons={[
        {
          icon: "fa-plus",
          text: "NUEVO PROGRAMA",
        },
      ]}
    />
    <div class="pb-6 px-10">
      <ProgramasContent client:load />
    </div>
    <ProgramasModalHost client:load />
  </div>
</DashboardLayout>
