---
import ConsultasTecnicasContent from "@/components/vigilancia/ConsultasTecnicasContent";
import ConsultaTecnicaModalHost from "@/components/vigilancia/ConsultaTecnicaModalHost";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Consultas técnicas"
  description="Módulo de consultas técnicas"
>
  <div class="flex flex-1 flex-col overflow-y-auto">
    <VigilanciaPagePlaceholder
      title="Consultas técnicas"
      icon="fa-laptop-medical"
      description="Segunda opinión de especialistas Lucemedic"
      buttons={[
        {
          text: "Nueva consulta",
          icon: "fa-plus",
        },
      ]}
    />
    <div class="pb-6 px-10">
      <ConsultasTecnicasContent client:load />
    </div>
    <ConsultaTecnicaModalHost client:load />
  </div>
</DashboardLayout>
