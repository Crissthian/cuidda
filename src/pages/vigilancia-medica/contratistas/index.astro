---
import ContratistasContent from "@/components/vigilancia/ContratistasContent";
import ContratistasModalHost from "@/components/vigilancia/ContratistasModalHost";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout title="Contratistas" description="Módulo de contratistas">
  <div class="flex flex-1 flex-col overflow-y-auto">
    <VigilanciaPagePlaceholder
      title="Contratistas"
      icon="fa-truck"
      description="Módulo contratistas del sistema de vigilancia médica ocupacional CUIDDA."
      buttons={[
        {
          icon: "fa-plus",
          text: "REGISTRAR CONTRATISTA",
        },
      ]}
    />
    <div class="pb-6 px-10">
      <ContratistasContent client:load />
    </div>
    <ContratistasModalHost client:load />
  </div>
</DashboardLayout>
