---
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import PlanAnualContent from "@/components/plan-anual/PlanAnualContent";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout
  title="Plan anual de salud ocupacional"
  description="Módulo de plan anual de salud ocupacional"
>
  <div class="flex flex-1 flex-col overflow-y-auto">
    <VigilanciaPagePlaceholder
      title="Plan anual de salud ocupacional"
      icon="fa-file-medical"
      description="El módulo genera un plan preliminar con la data cargada de línea base, IPERC, monitoreos y hallazgos; luego permite ajustarlo, aprobarlo y seguir su cumplimiento."
      buttons={[
        {
          text: "CARGAR PLAN",
          icon: "fa-upload",
        },
      ]}
    />
    <div class="pb-6 px-10">
      <PlanAnualContent client:load />
    </div>
  </div>
</DashboardLayout>
