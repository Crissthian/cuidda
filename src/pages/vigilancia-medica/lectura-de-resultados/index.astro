---
import EnviarResultadosModalHost from "@/components/vigilancia/EnviarResultadosModalHost";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { lecturasResultados } from "@/lib/lecturaResultadosData";

const kpis = [
    {
        id: "pendientes",
        label: "EMOS PENDIENTES\nDE LECTURA",
        value: "6",
        sub: "8 EMOs cerrados",
        icon: "fa-file-circle-question",
        iconBg: "bg-[#e6f0ff]",
        iconColor: "text-brand",
    },
    {
        id: "completadas",
        label: "LECTURAS\nCOMPLETADAS",
        value: "2",
        sub: "2 con firma efectiva",
        icon: "fa-file-circle-check",
        iconBg: "bg-risk-salmon/15",
        iconColor: "text-risk-salmon",
    },
    {
        id: "g1",
        label: "PENDIENTES\nG1",
        value: "1",
        sub: "Entrega remota",
        icon: "fa-file-shield",
        iconBg: "bg-[#e0f8f0]",
        iconColor: "text-[#0bbb8a]",
    },
    {
        id: "g2g3",
        label: "PENDIENTES\nG2/G3",
        value: "5",
        sub: "Lectura presencial en UME",
        icon: "fa-file-circle-exclamation",
        iconBg: "bg-risk-red/10",
        iconColor: "text-risk-red",
    },
];

const grupoStyles: Record<string, { badge: string; dot: string }> = {
    G1: { badge: "bg-success/15 text-success-dark", dot: "bg-success" },
    G2: { badge: "bg-risk-salmon/15 text-risk-salmon", dot: "bg-risk-salmon" },
    G3: { badge: "bg-risk-red/10 text-risk-red", dot: "bg-risk-red" },
};

const trabajadores = lecturasResultados.map((l) => ({
    id: l.id,
    nombre: l.nombre,
    dni: l.dni,
    sede: l.sede,
    puesto: l.puesto,
    emo: l.emo,
    fecha: l.fecha,
    expiracion: l.expiracion,
    grupo: l.grupo,
    modalidad: l.modalidad,
    estado: l.estadoLabel,
    estadoClasses:
        l.estado === "COMPLETADA"
            ? "bg-[#dcfce7] text-[#16a34a]"
            : "bg-risk-red/10 text-risk-red",
    accion:
        l.id === 5 ? "ENVIAR_VER" : l.estado === "COMPLETADA" ? "VER" : "REGISTRAR",
}));
---

<DashboardLayout
    title="Lectura de resultados"
    description="Módulo de lectura de resultados"
>
    <div class="flex flex-1 flex-col overflow-y-auto text-xs">
        <VigilanciaPagePlaceholder
            title="Lectura de resultados EMO"
            icon="fa-book-open-reader"
            description="Gestión SST · evidencia de entrega y lectura de resultados por trabajador"
            buttons={[{ icon: "fa-file-pdf", text: "EXPORTAR PDF" }]}
        />

        <div class="flex flex-col gap-5 px-10 pb-6">
            <!-- ── KPIs ── -->
            <section aria-label="Indicadores de lectura de resultados">
                <div
                    class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
                >
                    {
                        kpis.map((kpi) => (
                            <div class="flex items-center gap-4 rounded-xl bg-surface-default px-6 py-5 shadow-sm shadow-border-default">
                                <span
                                    class={`flex size-14 shrink-0 items-center justify-center rounded-xl ${kpi.iconBg}`}
                                    aria-hidden="true"
                                >
                                    <i
                                        class={`fa-solid ${kpi.icon} text-2xl ${kpi.iconColor}`}
                                    />
                                </span>
                                <div class="flex flex-col">
                                    <span class="whitespace-pre-line text-sm leading-tight tracking-wide text-text-secondary">
                                        {kpi.label}
                                    </span>
                                    <span class="mt-1 text-2xl font-bold leading-none text-brand">
                                        {kpi.value}
                                    </span>
                                    <span class="mt-1 text-xs text-success-dark">
                                        {kpi.sub}
                                    </span>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- ── KPI DE CUMPLIMIENTO ── -->
            <section
                aria-label="KPI de cumplimiento"
                class="flex items-stretch overflow-hidden rounded-xl bg-surface-default shadow-sm shadow-border-default"
            >
                <span class="w-2 shrink-0 bg-violet" aria-hidden="true"></span>
                <div class="flex flex-1 items-center gap-4 px-6 py-4">
                    <span
                        class="flex size-11 shrink-0 items-center justify-center rounded-full bg-violet/15"
                        aria-hidden="true"
                    >
                        <i class="fa-solid fa-bullseye text-2xl text-violet"
                        ></i>
                    </span>
                    <h2
                        class="text-sm font-medium tracking-wide text-text-primary"
                    >
                        KPI DE CUMPLIMIENTO
                    </h2>
                    <p class="text-sm text-text-secondary">
                        2 de 8 con gestión completa
                    </p>
                    <p class="ml-2 text-3xl font-bold leading-none text-brand">
                        25%
                    </p>
                </div>
            </section>

            <!-- ── FILTROS + TABLA ── -->
            <section
                aria-labelledby="lectura-title"
                class="rounded-xl bg-surface-default p-5 shadow-sm shadow-border-default"
            >
                <h2 id="lectura-title" class="sr-only">
                    Lectura de resultados por trabajador
                </h2>

                <!-- Filtros -->
                <form
                    role="search"
                    aria-label="Filtros de lectura de resultados"
                    class="flex items-center gap-3"
                >
                    <label for="f-apellidos" class="sr-only">Apellidos</label>
                    <input
                        id="f-apellidos"
                        type="text"
                        placeholder="Apellidos"
                        autocomplete="off"
                        class="form-input h-9 min-w-0 flex-1 bg-surface-light px-3 text-xs text-text-primary placeholder:text-muted-50 focus:ring-1 focus:ring-brand"
                    />
                    <label for="f-dni" class="sr-only">DNI</label>
                    <input
                        id="f-dni"
                        type="text"
                        placeholder="DNI"
                        autocomplete="off"
                        inputmode="numeric"
                        class="form-input h-9 min-w-0 flex-1 bg-surface-light px-3 text-xs text-text-primary placeholder:text-muted-50 focus:ring-1 focus:ring-brand"
                    />
                    <label for="f-sede" class="sr-only">Sede</label>
                    <span class="relative min-w-0 flex-1">
                        <select
                            id="f-sede"
                            aria-label="Sede"
                            class="form-select h-9 w-full appearance-none bg-surface-light pl-3 pr-8 text-xs text-muted-50 outline-none focus:ring-1 focus:ring-brand"
                        >
                            <option value="" selected>Sede</option>
                            <option value="condorcocha">Condorcocha</option>
                            <option value="atococongo">Atococongo</option>
                            <option value="conchan">Conchán</option>
                        </select>
                    </span>
                    <label for="f-grupo" class="sr-only">Grupo de riesgo</label>
                    <span class="relative min-w-0 flex-1">
                        <select
                            id="f-grupo"
                            aria-label="Grupo de riesgo"
                            class="form-select h-9 w-full appearance-none bg-surface-light pl-3 pr-8 text-xs text-muted-50 outline-none focus:ring-1 focus:ring-brand"
                        >
                            <option value="" selected>Grupo de riesgo</option>
                            <option value="G1">G1</option>
                            <option value="G2">G2</option>
                            <option value="G3">G3</option>
                        </select>
                    </span>
                    <label for="f-periodo" class="sr-only">Periodo</label>
                    <span class="relative min-w-0 flex-1">
                        <select
                            id="f-periodo"
                            aria-label="Periodo"
                            class="form-select h-9 w-full appearance-none bg-surface-light pl-3 pr-8 text-xs text-muted-50 outline-none focus:ring-1 focus:ring-brand"
                        >
                            <option value="" selected>Periodo</option>
                            <option value="2026">Periódico 2026</option>
                            <option value="2025">Periódico 2025</option>
                        </select>
                    </span>
                    <label for="f-modalidad" class="sr-only">Modalidad</label>
                    <span class="relative min-w-0 flex-1">
                        <select
                            id="f-modalidad"
                            aria-label="Modalidad"
                            class="form-select h-9 w-full appearance-none bg-surface-light pl-3 pr-8 text-xs text-muted-50 outline-none focus:ring-1 focus:ring-brand"
                        >
                            <option value="" selected>Modalidad</option>
                            <option value="presencial">Presencial</option>
                            <option value="remota">Remota</option>
                        </select>
                    </span>
                    <label for="f-estado" class="sr-only">Estado</label>
                    <span class="relative min-w-0 flex-1">
                        <select
                            id="f-estado"
                            aria-label="Estado"
                            class="form-select h-9 w-full appearance-none bg-surface-light pl-3 pr-8 text-xs text-muted-50 outline-none focus:ring-1 focus:ring-brand"
                        >
                            <option value="" selected>Estado</option>
                            <option value="completada"
                                >Lectura completada</option
                            >
                            <option value="requiere"
                                >Requiere atención presencial</option
                            >
                        </select>
                    </span>
                    <button
                        type="submit"
                        class="inline-flex h-9 shrink-0 items-center justify-center rounded-lg bg-brand px-8 text-xs font-bold uppercase tracking-wide text-white shadow-sm transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
                    >
                        Buscar
                    </button>
                </form>

                <!-- Tabla -->
                <div class="mt-5 overflow-x-auto">
                    <div
                        class="min-w-300 text-xs"
                        role="table"
                        aria-label="Lectura de resultados por trabajador"
                    >
                        <!-- header -->
                        <div
                            class="grid grid-cols-[1.4fr_0.8fr_1fr_0.9fr_0.5fr_0.7fr_1.3fr_1fr] gap-0 rounded-lg bg-surface-light px-4 py-3 text-[11px] font-medium uppercase tracking-wider text-text-secondary"
                            role="row"
                        >
                            <span role="columnheader">Trabajador</span>
                            <span role="columnheader">Sede</span>
                            <span role="columnheader">Puesto</span>
                            <span role="columnheader">EMO</span>
                            <span role="columnheader">Grupo</span>
                            <span role="columnheader">Modalidad</span>
                            <span role="columnheader" class="text-center"
                                >Estado</span
                            >
                            <span role="columnheader" class="text-center"
                                >Acción</span
                            >
                        </div>
                        <!-- rows -->
                        <div class="flex flex-col">
                            {
                                trabajadores.map((row) => (
                                    <div
                                        role="row"
                                        class="grid grid-cols-[1.4fr_0.8fr_1fr_0.9fr_0.5fr_0.7fr_1.3fr_1fr] items-center gap-0 border-b border-dashed border-border-default px-4 py-4 transition-colors last:border-b-0 hover:bg-surface-light/50"
                                    >
                                        <span role="cell" class="pr-2">
                                            <span class="block text-xs font-semibold leading-tight text-text-primary">
                                                {row.nombre}
                                            </span>
                                            <span class="mt-0.5 block text-xs leading-tight text-muted">
                                                DNI: {row.dni}
                                            </span>
                                        </span>
                                        <span
                                            role="cell"
                                            class="pr-2 text-xs text-text-secondary"
                                        >
                                            {row.sede}
                                        </span>
                                        <span
                                            role="cell"
                                            class="pr-2 text-xs leading-snug text-text-secondary"
                                        >
                                            {row.puesto}
                                        </span>
                                        <span role="cell" class="pr-2">
                                            <span class="block text-xs font-semibold leading-tight text-text-primary">
                                                {row.emo}
                                            </span>
                                            <span class="mt-0.5 block text-xs leading-tight text-muted">
                                                {row.fecha}
                                            </span>
                                        </span>
                                        <span role="cell" class="pr-2">
                                            <span
                                                class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold leading-none ${grupoStyles[row.grupo].badge}`}
                                            >
                                                <span
                                                    class={`size-2 rounded-full ${grupoStyles[row.grupo].dot}`}
                                                    aria-hidden="true"
                                                />
                                                {row.grupo}
                                            </span>
                                        </span>
                                        <span
                                            role="cell"
                                            class="pr-2 text-xs text-text-secondary"
                                        >
                                            {row.modalidad}
                                        </span>
                                        <span
                                            role="cell"
                                            class="flex justify-center px-2"
                                        >
                                            <span
                                                class={`inline-flex w-full max-w-55 items-center justify-center rounded-full px-3 py-1 text-center text-[10px] font-semibold leading-tight tracking-wide ${row.estadoClasses}`}
                                            >
                                                {row.estado}
                                            </span>
                                        </span>
                                        <span
                                            role="cell"
                                            class="flex items-center justify-center gap-2"
                                        >
                                            {row.accion === "ENVIAR_VER" ? (
                                                <>
                                                    <button
                                                        type="button"
                                                        data-modal-enviar={row.id}
                                                        data-nombre={row.nombre}
                                                        data-dni={row.dni}
                                                        data-emo={row.emo}
                                                        data-vencimiento={row.expiracion}
                                                        class="inline-flex items-center gap-1.5 rounded-lg bg-[#22c55e] px-3 py-1.5 text-[11px] font-bold tracking-wide text-white transition-colors hover:brightness-95"
                                                        aria-label={`Enviar por WhatsApp a ${row.nombre}`}
                                                    >
                                                        <i
                                                            class="fa-brands fa-whatsapp text-xs"
                                                            aria-hidden="true"
                                                        />
                                                        ENVIAR
                                                    </button>
                                                    <a
                                                        href={`/vigilancia-medica/lectura-de-resultados/${row.id}`}
                                                        class="inline-flex min-w-16 items-center justify-center rounded-lg bg-muted px-4 py-1.5 text-[11px] font-bold tracking-wide text-white transition-colors hover:bg-muted-80"
                                                        aria-label={`Ver lectura de ${row.nombre}`}
                                                    >
                                                        VER
                                                    </a>
                                                </>
                                            ) : (
                                                <a
                                                    href={`/vigilancia-medica/lectura-de-resultados/${row.id}`}
                                                    class="inline-flex min-w-24 items-center justify-center rounded-lg bg-muted px-4 py-1.5 text-[11px] font-bold tracking-wide text-white transition-colors hover:bg-muted-80"
                                                    aria-label={`${row.accion === "VER" ? "Ver lectura de" : "Registrar lectura de"} ${row.nombre}`}
                                                >
                                                    {row.accion}
                                                </a>
                                            )}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <EnviarResultadosModalHost client:load />
    </div>
</DashboardLayout>
