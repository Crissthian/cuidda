---
import EnviarResultadosModalHost from "@/components/vigilancia/EnviarResultadosModalHost";
import LecturaResultadosContent from "@/components/vigilancia/LecturaResultadosContent";
import VigilanciaPagePlaceholder from "@/components/vigilancia/VigilanciaPagePlaceholder.astro";
import DashboardLayout from "@/layouts/DashboardLayout.astro";

const kpis = [
  {
    id: "pendientes",
    label: "EMOS PENDIENTES\nDE LECTURA",
    value: "6",
    sub: "8 EMOs cerrados",
    icon: "fa-file-circle-question",
    iconBg: "bg-[#e6f0ff]",
    iconColor: "text-brand",
  },
  {
    id: "completadas",
    label: "LECTURAS\nCOMPLETADAS",
    value: "2",
    sub: "2 con firma efectiva",
    icon: "fa-file-circle-check",
    iconBg: "bg-risk-salmon/15",
    iconColor: "text-risk-salmon",
  },
  {
    id: "g1",
    label: "PENDIENTES\nG1",
    value: "1",
    sub: "Entrega remota",
    icon: "fa-file-shield",
    iconBg: "bg-[#e0f8f0]",
    iconColor: "text-[#0bbb8a]",
  },
  {
    id: "g2g3",
    label: "PENDIENTES\nG2/G3",
    value: "5",
    sub: "Lectura presencial en UME",
    icon: "fa-file-circle-exclamation",
    iconBg: "bg-risk-red/10",
    iconColor: "text-risk-red",
  },
];
---

<DashboardLayout
  title="Lectura de resultados"
  description="Módulo de lectura de resultados"
>
  <div class="flex flex-1 flex-col overflow-y-auto text-xs">
    <VigilanciaPagePlaceholder
      title="Lectura de resultados EMO"
      icon="fa-book-open-reader"
      description="Gestión SST · evidencia de entrega y lectura de resultados por trabajador"
      buttons={[{ icon: "fa-file-pdf", text: "EXPORTAR PDF" }]}
    />

    <div class="flex flex-col gap-5 px-10 pb-6">
      <!-- ── KPIs ── -->
      <section aria-label="Indicadores de lectura de resultados">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            kpis.map((kpi) => (
              <div class="flex items-center gap-4 rounded-xl bg-surface-default px-6 py-5 shadow-sm shadow-border-default">
                <span
                  class={`flex size-14 shrink-0 items-center justify-center rounded-xl ${kpi.iconBg}`}
                  aria-hidden="true"
                >
                  <i class={`fa-solid ${kpi.icon} text-2xl ${kpi.iconColor}`} />
                </span>
                <div class="flex flex-col">
                  <span class="whitespace-pre-line text-sm leading-tight tracking-wide text-text-secondary">
                    {kpi.label}
                  </span>
                  <span class="mt-1 text-2xl font-bold leading-none text-brand">
                    {kpi.value}
                  </span>
                  <span class="mt-1 text-xs text-success-dark">{kpi.sub}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ── KPI DE CUMPLIMIENTO ── -->
      <section
        aria-label="KPI de cumplimiento"
        class="flex items-stretch overflow-hidden rounded-xl bg-surface-default shadow-sm shadow-border-default"
      >
        <span class="w-2 shrink-0 bg-violet" aria-hidden="true"></span>
        <div class="flex flex-1 items-center gap-4 px-6 py-4">
          <span
            class="flex size-11 shrink-0 items-center justify-center rounded-full bg-violet/15"
            aria-hidden="true"
          >
            <i class="fa-solid fa-bullseye text-2xl text-violet"></i>
          </span>
          <h2 class="text-sm font-medium tracking-wide text-text-primary">
            KPI DE CUMPLIMIENTO
          </h2>
          <p class="text-sm text-text-secondary">2 de 8 con gestión completa</p>
          <p class="ml-2 text-3xl font-bold leading-none text-brand">25%</p>
        </div>
      </section>

      <!-- ── FILTROS + TABLA ── -->
      <LecturaResultadosContent client:load />
    </div>
    <EnviarResultadosModalHost client:load />
  </div>
</DashboardLayout>
