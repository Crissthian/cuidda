---
import RegistroPacientes from "@/components/asistencial/pacientes/RegistroPacientes";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout title="Pacientes" description="Módulo de pacientes">
  <section class="px-6 pb-6" aria-labelledby="pacientes-heading">
    <header class="px-6 mb-4">
      <h1 id="pacientes-heading" class="text-2xl font-semibold text-brand">
        Pacientes
      </h1>
      <p class="text-sm text-text-primary">
        Busca pacientes por apellido o N° de historia clínica.
      </p>
    </header>
    <RegistroPacientes client:only="react" />
  </section>
</DashboardLayout>