---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { submodulosInformes } from "@/lib/farmaciaData";
---

<DashboardLayout title="Informes" description="Gestión de informes de farmacia">
  <section
    class="px-4 py-14 sm:px-10 sm:py-16"
    aria-labelledby="informes-heading"
  >
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-12">
      <header class="text-center">
        <h1 id="informes-heading" class="text-5xl font-semibold text-brand">
          Informes
        </h1>
        <p class="mt-3 text-lg text-text-primary">
          Gestiona los informes de la farmacia
        </p>
      </header>

      <nav aria-label="Secciones del módulo de informes" class="w-full">
        <ul
          class="mx-auto grid max-w-4xl grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 justify-items-center"
        >
          {
            submodulosInformes.map((submodulo) => (
              <li class="flex justify-center">
                <a
                  href={submodulo.href}
                  class="group block h-48 w-48 rounded-3xl bg-surface-light p-6 text-center transition ease-in-out hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                  aria-label={submodulo.ariaLabel}
                >
                  <div class="flex h-full flex-col items-center justify-center gap-3">
                    <i
                      class={`fa-solid ${submodulo.icon} text-6xl text-brand`}
                      aria-hidden="true"
                    />
                    <h2 class="text-2xl font-semibold text-muted text-center leading-tight">
                      {submodulo.label}
                    </h2>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</DashboardLayout>
