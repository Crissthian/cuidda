---
import LoginPage from "@/components/LoginPage";
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout
  title="Iniciar sesión | Cuidda"
  description="Acceso al sistema médico Cuidda"
>
  <LoginPage client:load />

  <style>
    html,
    body {
      overflow: hidden;
      height: 100%;
      width: 100%;
      margin: 0;
    }

    #login-main {
      font-size: 0.75rem;
      line-height: 1rem;
      overflow: hidden;
      box-sizing: border-box;
    }

    #login-main img[alt*="Profesional"] {
      max-width: none;
    }
  </style>
</AppLayout>
