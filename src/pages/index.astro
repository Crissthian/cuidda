---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Iniciar sesión | Cuidda" description="Acceso al sistema médico Cuidda">
	<main class="login" aria-labelledby="login-title">
		<div class="login-background" aria-hidden="true">
			<img src="/figma-fondo-login.png" alt="" />
		</div>
		<div class="blue-background" aria-hidden="true"></div>
		<img class="hero-art" src="/figma-ilustracion-login.png" alt="Profesional médico usando Cuidda" />
		<img class="cuidda-logo" src="/figma-logo-cuidda.png" alt="cuidda by Lucemedic" />
		<img class="lucemedic-logo" src="/figma-logo-lumecedic.png" alt="Lucemedic" />

		<section class="login-card" aria-label="Formulario de acceso">
			<h1 id="login-title">INICIAR SESIÓN</h1>
			<form id="login-form" novalidate>
				<label class="input-shell" for="username">
					<span class="input-icon" aria-hidden="true">♟</span>
					<span class="sr-only">Usuario</span>
					<input id="username" name="username" type="text" autocomplete="username" placeholder="USUARIO:" />
				</label>
				<span class="error" id="username-error"></span>
				<label class="input-shell" for="password">
					<span class="input-icon" aria-hidden="true">▣</span>
					<span class="sr-only">Contraseña</span>
					<input id="password" name="password" type="password" autocomplete="current-password" placeholder="CONTRASEÑA:" />
				</label>
				<span class="error" id="password-error"></span>
				<p class="status" id="form-status" role="status" aria-live="polite"></p>
				<button type="submit">INGRESAR</button>
			</form>
		</section>

		<section class="support" aria-label="Central de atención">
			<div class="support-heading"><span class="headset" aria-hidden="true">◉</span><strong>+51 980 773 060</strong></div>
			<strong>CENTRAL DE ATENCIÓN</strong>
			<p>Si no puedes acceder, comunícate con nosotros y<br />nuestro equipo técnico te ayudará a la brevedad posible.</p>
		</section>
	</main>
</AppLayout>

<script>
	const form = document.querySelector<HTMLFormElement>('#login-form');
	const username = document.querySelector<HTMLInputElement>('#username');
	const password = document.querySelector<HTMLInputElement>('#password');
	const usernameError = document.querySelector<HTMLSpanElement>('#username-error');
	const passwordError = document.querySelector<HTMLSpanElement>('#password-error');
	const status = document.querySelector<HTMLParagraphElement>('#form-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!username || !password || !usernameError || !passwordError || !status) return;
		usernameError.textContent = '';
		passwordError.textContent = '';
		status.textContent = '';
		username.removeAttribute('aria-invalid');
		password.removeAttribute('aria-invalid');

		let valid = true;
		if (!username.value.trim()) {
			usernameError.textContent = 'Ingresa tu usuario.';
			username.setAttribute('aria-invalid', 'true');
			valid = false;
		}
		if (!password.value) {
			passwordError.textContent = 'Ingresa tu contraseña.';
			password.setAttribute('aria-invalid', 'true');
			valid = false;
		}
		if (!valid) {
			(valid ? username : username.value ? password : username).focus();
			return;
		}
		status.className = 'status success';
		status.textContent = 'Acceso validado. Continuarías al tablero general.';
	});
</script>

<style>
	.login {
		position: relative;
		overflow: hidden;
		min-height: 100vh;
		background: #fff;
	}

	.login-background,
	.blue-background,
	.hero-art,
	.cuidda-logo,
	.lucemedic-logo,
	.login-card,
	.support {
		position: absolute;
	}

	.login-background {
		inset: 0 51.46% 0 0;
		overflow: hidden;
	}

	.login-background img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.25;
	}

	.blue-background {
		inset: 0 0 0 48.54%;
		background: linear-gradient(to bottom, #1ee67d 0%, #0064d2 100%);
	}

	.hero-art {
		top: 11.3%;
		left: 1.98%;
		width: 58.59%;
		height: auto;
	}

	.cuidda-logo {
		top: 11.3%;
		left: 11.88%;
		width: 25.98%;
		height: auto;
	}

	.lucemedic-logo {
		right: 21.35%;
		bottom: 6.57%;
		width: 8.81%;
		height: auto;
		opacity: 0.5;
	}

	.login-card {
		top: 23.43%;
		right: 9.01%;
		width: 33.44%;
		height: 42.13%;
		border-radius: 62px;
		background: rgb(255 255 255 / 15%);
		padding: 6.2% 5.5%;
		color: #f1f5f8;
	}

	.login-card h1 {
		margin: 0 0 8.5%;
		font: 700 clamp(1rem, 1.67vw, 2rem) / 1 Roboto, Arial, sans-serif;
		text-align: center;
	}

	form {
		display: grid;
		gap: 0;
	}

	.input-shell {
		display: flex;
		align-items: center;
		height: 7.78%;
		min-height: 38px;
		border-radius: 24px;
		background: #f1f5f8;
		padding: 0 7%;
		color: #8ea9ba;
	}

	.input-shell + .error { margin-bottom: 4.4%; }
	.input-icon { width: 20px; margin-right: 10px; font-size: 0.9rem; }
	input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: #416377;
		font: 500 clamp(0.62rem, 0.83vw, 1rem) Roboto, Arial, sans-serif;
	}
	input::placeholder { color: #8ea9ba; opacity: 1; }
	input[aria-invalid="true"] { color: #b43d3d; }
	.error { display: block; min-height: 14px; padding: 3px 7%; color: #ffe1e1; font: 500 0.7rem Roboto, Arial, sans-serif; }
	.status { min-height: 22px; margin: 3px 0 6px; color: #ffe1e1; font: 500 0.72rem Roboto, Arial, sans-serif; text-align: center; }
	.status.success { color: #e8fff0; }
	button {
		width: 30%;
		min-width: 92px;
		margin: 0 auto;
		border: 0;
		border-radius: 19px;
		background: #0064d2;
		color: white;
		cursor: pointer;
		padding: 11px 6px;
		font: 600 clamp(0.62rem, 1.04vw, 1.25rem) Roboto, Arial, sans-serif;
		transition: filter 160ms ease;
	}
	button:hover { filter: brightness(1.15); }

	.support {
		right: 16.51%;
		bottom: 16.11%;
		width: 18.5%;
		color: #f1f5f8;
		font: 500 clamp(0.55rem, 0.73vw, 0.88rem) / 1.2 Roboto, Arial, sans-serif;
		text-align: center;
	}
	.support-heading { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: clamp(0.7rem, 1.04vw, 1.25rem); }
	.support > strong { font-size: clamp(0.55rem, 0.83vw, 1rem); }
	.support p { margin: 10px 0 0; font-size: clamp(0.45rem, 0.65vw, 0.78rem); }
	.headset { font-size: 1.4em; }
	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

	@media (max-width: 720px) {
		.login { min-height: 720px; }
		.login-background { inset: 0; }
		.blue-background { inset: 0; opacity: 0.92; }
		.hero-art { top: 0; left: -13%; width: 90%; opacity: 0.35; }
		.cuidda-logo { top: 6%; left: 9%; width: 42%; }
		.login-card { top: 27%; right: 8%; width: 84%; height: auto; min-height: 300px; padding: 48px 10%; border-radius: 34px; }
		.login-card h1 { font-size: 1.25rem; }
		.input-shell { min-height: 44px; }
		.support { right: 10%; bottom: 7%; width: 80%; }
		.lucemedic-logo { right: 42%; bottom: 1.5%; width: 16%; }
	}
</style>
