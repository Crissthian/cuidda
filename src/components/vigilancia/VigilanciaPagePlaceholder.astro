---
interface Props {
  title: string;
  icon?: string;
  description?: string;
  buttons?: ButtonProps[];
}

interface ButtonProps {
  state?: boolean;
  icon: string;
  text: string;
}

const {
  title,
  description = "Contenido del módulo pendiente de implementar.",
  buttons = [],
} = Astro.props;
---

<section
  class="flex flex-1 flex-row justify-between pt-6"
  aria-labelledby="vigilancia-page-title"
>
  <div>
    <h1
      id="vigilancia-page-title"
      class="text-lg font-bold uppercase tracking-wide text-brand"
    >
      {title}
    </h1>
    <p class="mt-1 max-w-5xl text-sm leading-relaxed text-muted">
      {description}
    </p>
  </div>
  {
    buttons.length > 0 && (
      <div class="flex flex-row gap-2">
        {buttons.map(
          (button) =>
            button.state !== false && (
              <button
                type="button"
                class="h-10 flex items-center gap-2 rounded-lg bg-muted-20 px-4 text-xs font-semibold text-muted shadow-sm hover:bg-muted-30"
              >
                <i
                  class={`fa-solid ${button.icon} text-[11px]`}
                  aria-hidden="true"
                />
                {button.text}
              </button>
            ),
        )}
      </div>
    )
  }
</section>
