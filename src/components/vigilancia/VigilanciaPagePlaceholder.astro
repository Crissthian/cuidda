---
interface Props {
  title: string;
  icon?: string;
  description?: string;
}

const {
  title,
  icon = "fa-folder-open",
  description = "Contenido del módulo pendiente de implementar.",
} = Astro.props;
---

<section
  class="flex flex-1 flex-col overflow-hidden px-14 pt-14"
  aria-labelledby="vigilancia-page-title"
>
  <h1
    id="vigilancia-page-title"
    class="text-lg font-bold uppercase tracking-wide text-brand"
  >
    {title}
  </h1>
  <p class="mt-1 max-w-4xl text-sm leading-relaxed text-muted">
    {description}
  </p>
</section>
