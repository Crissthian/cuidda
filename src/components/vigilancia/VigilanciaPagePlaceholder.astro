---
interface Props {
  title: string;
  icon?: string;
  description?: string;
  buttons?: ButtonProps[];
}

interface ButtonProps {
  state?: boolean;
  icon: string;
  text: string;
  classes?: string[];
}

const {
  title,
  description = "Contenido del módulo pendiente de implementar.",
  buttons = [] as ButtonProps[],
} = Astro.props;
---

<section
  class="flex flex-1 flex-row justify-between py-4 px-10"
  aria-labelledby="vigilancia-page-title"
>
  <div>
    <h1
      id="vigilancia-page-title"
      class="text-lg font-bold uppercase tracking-wide text-brand"
    >
      {title}
    </h1>
    <p class="mt-1 max-w-5xl text-sm leading-relaxed text-muted">
      {description}
    </p>
  </div>
  {
    buttons.length > 0 && (
      <div class="flex flex-row gap-2">
        {buttons.map(
          ({ state, icon, text, classes = ["bg-muted-20 text-muted"] }) =>
            state !== false && (
              <button
                type="button"
                data-modal-trigger={
                  text === "CARGAR DOCUMENTO"
                    ? "cargar-documento"
                    : text === "IMPORTAR PLANILLA"
                      ? "importar-planilla"
                      : text === "NUEVA MATRIZ"
                        ? "nueva-matriz"
                        : text === "CARGAR MATRIZ Y LEGAJOS"
                          ? "cargar-matriz"
                          : text === "PROGRAMAR MONITOREO"
                            ? "programar-monitoreo"
                            : text === "CARGAR INFORME"
                              ? "cargar-informe"
                              : text === "CARGAR PROTOCOLO"
                                ? "cargar-protocolo"
                                : text === "ACTUALIZAR PROTOCOLO"
                                  ? "actualizar-protocolo"
                                  : text === "Nueva consulta"
                                    ? "nueva-consulta"
                                    : undefined
                }
                class={`flex h-10 items-center gap-2 rounded-lg px-4 text-xs font-semibold shadow-sm hover:bg-muted-30 ${classes.join(" ")}`}
              >
                <i class={`fa-solid ${icon} text-[11px]`} aria-hidden="true" />
                {text}
              </button>
            ),
        )}
      </div>
    )
  }
</section>
