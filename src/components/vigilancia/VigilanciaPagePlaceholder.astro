---
interface Props {
  title: string;
  icon?: string;
  description?: string;
}

const {
  title,
  icon = "fa-folder-open",
  description = "Contenido del módulo pendiente de implementar.",
} = Astro.props;
---

<section
  class="flex flex-1 flex-col overflow-hidden px-14 pt-14"
  aria-labelledby="vigilancia-page-title"
>
  <h1
    id="vigilancia-page-title"
    class="text-2xl font-bold uppercase tracking-wide text-brand"
  >
    {title}
  </h1>
  <p class="mt-4 max-w-4xl text-sm leading-relaxed text-muted">
    {description}
  </p>

  <div class="mt-10 flex flex-1 items-center justify-center">
    <div
      class="flex w-full max-w-3xl flex-col items-center gap-4 rounded-2xl border border-border-subtle bg-white p-12 text-center shadow-sm"
    >
      <span
        class="flex size-16 items-center justify-center rounded-2xl bg-muted-20 text-brand"
      >
        <i class={`fa-solid ${icon} text-2xl`} aria-hidden="true"></i>
      </span>
      <h2 class="text-xl font-bold text-text-primary">{title}</h2>
      <p class="text-xs text-text-secondary">{description}</p>
    </div>
  </div>
</section>
