---
export interface Props {
  /**
   * Si no se pasa, se usa Astro.url.pathname
   * Ej: "/asistencial/admision"
   */
  path?: string;

  /**
   * Mapeo para renombrar segmentos o poner iconos
   * Ej: { asistencial: { label: "Asistencial", icon: "fa-solid fa-user-doctor" } }
   */
  labels?: Record<string, { label?: string; icon?: string }>;
}

const { path, labels = {} } = Astro.props;

// 1. Obtener la ruta
const pathname = path ?? Astro.url.pathname; // /asistencial/admision
const segments = pathname.split("/").filter(Boolean); // ["asistencial","admision"]

// 2. Generar crumbs
const crumbs = segments.map((slug, idx) => {
  const isLast = idx === segments.length - 1;
  const human =
    labels[slug]?.label ?? slug.charAt(0).toUpperCase() + slug.slice(1);
  const icon = labels[slug]?.icon;
  const href = "/" + segments.slice(0, idx + 1).join("/");
  return { slug, human, href, isLast, icon };
});
---

<nav aria-label="Breadcrumb" class="px-6 py-4 ms-4">
  <ol class="flex items-center gap-2 text-lg text-text-primary">
    <!-- Home siempre presente -->
    <li class="flex items-center gap-2 text-text-primary">
      {
        pathname === "/home" || pathname === "/" ? (
          <a href="/home">
            <i class="fas fa-home text-brand" aria-hidden="true" />
            <span class="text-brand font-semibold">Home</span>
          </a>
        ) : (
          <a href="/home">
            <i class="fas fa-home" aria-hidden="true" /> <span>Home</span>
          </a>
        )
      }
    </li>

    {
      crumbs.map(({ human, href, isLast, icon }) => (
        <li class="flex items-center gap-2">
          <span class="text-text-primary">/</span>

          {isLast ? (
            <span
              style="color:var(--color-brand)"
              class="font-semibold flex items-center gap-2"
            >
              {icon && <i class={icon} aria-hidden="true" />}
              {human}
            </span>
          ) : (
            <a href={href} class="flex items-center gap-2">
              {icon && <i class={icon} aria-hidden="true" />}
              {human}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
