---
interface Props {
  title: string;
  icon?: string;
  description?: string;
}

const {
  title,
  icon = "fa-folder-open",
  description = "Contenido del módulo pendiente de implementar.",
} = Astro.props;
---

<section
  class="flex h-full flex-col overflow-hidden"
  aria-labelledby="module-title"
>
  <nav
    class="flex items-center gap-2 px-10 pt-6 text-sm"
    aria-label="Breadcrumb"
  >
    <i class="fa-solid fa-house text-text-secondary" aria-hidden="true"></i>
    <span class="font-semibold text-brand">{title}</span>
  </nav>

  <div class="flex flex-1 items-center justify-center px-10 pb-10">
    <div
      class="flex w-full max-w-3xl flex-col items-center gap-4 rounded-2xl p-12 text-center shadow-sm"
    >
      <span
        class="flex size-16 items-center justify-center rounded-2xl bg-muted-20 text-brand"
      >
        <i class={`fa-solid ${icon} text-2xl`} aria-hidden="true"></i>
      </span>
      <h1 id="module-title" class="text-2xl font-bold text-text-primary">
        {title}
      </h1>
      <p class="text-xs text-text-secondary">{description}</p>
    </div>
  </div>
</section>
